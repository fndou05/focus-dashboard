################ Step 3a: prior history and grade scale ################

### 3a.1 Create user with prior history (201)
POST http://localhost:8080/users
Content-Type: application/json

{
  "email": "grades-{{$uuid}}@mail.com",
  "displayName": "Grader",
  "timezone": "America/New_York",
  "priorCredits": 45,
  "priorGpa": 3.4
}

> {% client.global.set("userId", response.body.id); %}

### 3a.2 Prior GPA out of range (400)
POST http://localhost:8080/users
Content-Type: application/json

{
  "email": "bad-{{$uuid}}@mail.com",
  "displayName": "Grader",
  "timezone": "America/New_York",
  "priorGpa": 9.0
}

### 3a.3 List the grade scale (200, 12 items, A first)
GET http://localhost:8080/users/{{userId}}/grade-cutoffs

> {% client.global.set("cutoffId", response.body[0].id); %}

### 3a.4 Change the A cutoff (200)
PATCH http://localhost:8080/grade-cutoffs/{{cutoffId}}
Content-Type: application/json

{
  "minPercent": 94
}

### 3a.5 Update prior GPA only (200, priorCredits stays 45)
PATCH http://localhost:8080/users/{{userId}}
Content-Type: application/json

{
  "priorGpa": 3.5
}


################ Setup for 3b onward ################

### Create semester (201)
POST http://localhost:8080/users/{{userId}}/semesters
Content-Type: application/json

{
  "name": "Fall 2026",
  "startDate": "2026-09-01",
  "endDate": "2026-12-20"
}

> {% client.global.set("semesterId", response.body.id); %}

### Create subject (201)
POST http://localhost:8080/semesters/{{semesterId}}/subjects
Content-Type: application/json

{
  "name": "Physics",
  "credits": 4,
  "selfRatedStrength": "AVERAGE"
}

> {% client.global.set("subjectId", response.body.id); %}


